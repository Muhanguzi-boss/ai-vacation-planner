DATABASE_URL=postgresql://user:password@localhost:5432/vacation_planner
SECRET_KEY=your-super-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=3000
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5
KNOWLEDGE_BASE_PATH=data/knowledge
VECTOR_STORE_PATH=data/vector_store.db
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_DIMENSIONS=2048
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.2
MAX_IMAGE_UPLOAD_MB=5
MCP_TIMEOUT_SECONDS=15
MCP_WEATHER_ENABLED=false
MCP_WEATHER_FALLBACK_ENABLED=true
MAX_TTS_TEXT_CHARS=3000
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_UPLOAD_MB=10
MAX_AUDIO_DURATION_SECONDS=300
TELEMETRY_ENABLED=true
TELEMETRY_LOG_ENABLED=true
# Datadog metrics over DogStatsD (UDP). Disabled by default; requires a running Datadog Agent.
DD_METRICS_ENABLED=false
DD_AGENT_HOST=localhost
DD_DOGSTATSD_PORT=8125
DD_SERVICE=ai-vacation-planner
DD_ENV=local
DD_VERSION=1.0.0
