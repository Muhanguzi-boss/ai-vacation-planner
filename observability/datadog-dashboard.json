                      "query": "sum:vacation_planner.llm.request.input_tokens{$env,$service} by {model}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "output",
                      "query": "sum:vacation_planner.llm.request.output_tokens{$env,$service} by {model}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "input",
                      "alias": "input tokens"
                    },
                    {
                      "formula": "output",
                      "alias": "output tokens"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Avg tokens per successful LLM request",
              "precision": 0,
              "autoscale": true,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "tokens",
                      "query": "sum:vacation_planner.llm.request.total_tokens{$env,$service,outcome:success}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "requests",
                      "query": "sum:vacation_planner.llm.request.count{$env,$service,outcome:success}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "tokens / requests"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "toplist",
              "title": "LLM failures by error category",
              "requests": [
